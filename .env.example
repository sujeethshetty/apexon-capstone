# The course-hosted model avoids downloading a local chat model.
CP01_MODE=hosted
CP01_DB_PATH=.chroma
CP01_DOCS_PATH=data/policies
# Paste the course-provided base URL locally; do not commit it.
# Example shape: http://your-course-host:11434
HOSTED_LLM_BASE_URL=
HOSTED_LLM_MODEL=llama3.2
# Select CP01_MODE=extractive for a demo without any generation API calls.
# If the hosted URL uses plain HTTP, send synthetic data only.

# OPTIONAL paid fallback, disabled by default: none | openai | anthropic
# Enabling sends questions/excerpts to that provider after transient hosted failures.
# API usage may incur charges. Keys stay in this private file; never commit them.
FALLBACK_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
